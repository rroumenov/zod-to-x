{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$ref": "#/definitions/UserModel",
    "definitions": {
        "UserModel": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "age": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                },
                "email": {
                    "anyOf": [
                        {
                            "type": "string",
                            "format": "email",
                            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "address": {
                    "$ref": "#/definitions/UserAddress"
                },
                "phoneNumbers": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "favoriteColors": {},
                "roles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/UserRole"
                    }
                },
                "status": {
                    "$ref": "#/definitions/UserStatus"
                },
                "metadata": {
                    "type": "object",
                    "propertyNames": {
                        "type": "string"
                    },
                    "additionalProperties": {}
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": ["string", "number", "boolean"]
                    }
                },
                "preferences": {
                    "type": "object",
                    "properties": {
                        "theme": {
                            "type": "string"
                        },
                        "notificationsEnabled": {
                            "type": "boolean"
                        },
                        "language": {
                            "type": "string"
                        },
                        "timeZone": {
                            "type": "string"
                        }
                    },
                    "required": ["theme", "notificationsEnabled", "language"],
                    "additionalProperties": false
                },
                "lastLogin": {
                    "anyOf": [
                        {},
                        {
                            "type": "null"
                        }
                    ]
                },
                "notes": {
                    "description": "This is a Notes attribute description.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "friends": {
                    "anyOf": [
                        {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/UserModel"
                            }
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "subscription": {
                    "$ref": "#/definitions/Subscription"
                }
            },
            "required": [
                "name",
                "address",
                "phoneNumbers",
                "favoriteColors",
                "roles",
                "status",
                "metadata",
                "tags",
                "preferences",
                "lastLogin",
                "subscription"
            ],
            "additionalProperties": false
        },
        "UserAddress": {
            "type": "object",
            "properties": {
                "street": {
                    "type": "string"
                },
                "city": {
                    "type": "string"
                },
                "zipCode": {
                    "type": ["string", "null"]
                }
            },
            "required": ["street", "city", "zipCode"],
            "additionalProperties": false
        },
        "UserRole": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "admin"
                },
                {
                    "type": "string",
                    "const": "editor"
                },
                {
                    "type": "string",
                    "const": "viewer"
                }
            ]
        },
        "UserStatus": {
            "type": "string",
            "enum": ["active", "inactive", "pending"],
            "description": "This is a UserStatus enumerate description."
        },
        "UserVisualPreferences": {
            "type": "object",
            "properties": {
                "theme": {
                    "type": "string"
                },
                "notificationsEnabled": {
                    "type": "boolean"
                }
            },
            "required": ["theme", "notificationsEnabled"],
            "additionalProperties": false
        },
        "UserRegionalPreferences": {
            "type": "object",
            "properties": {
                "language": {
                    "type": "string"
                },
                "timeZone": {
                    "type": "string"
                }
            },
            "required": ["language"],
            "additionalProperties": false
        },
        "Subscription": {
            "oneOf": [
                {
                    "$ref": "#/definitions/FreeSubscription"
                },
                {
                    "$ref": "#/definitions/PremiumSubscription"
                },
                {
                    "$ref": "#/definitions/EnterpriseSubscription"
                }
            ]
        },
        "FreeSubscription": {
            "type": "object",
            "properties": {
                "subscriptionType": {
                    "type": "string",
                    "const": "free"
                },
                "startDate": {},
                "endDate": {
                    "anyOf": [
                        {},
                        {
                            "type": "null"
                        }
                    ]
                },
                "adsEnabled": {
                    "type": "boolean"
                }
            },
            "required": ["subscriptionType", "startDate", "endDate", "adsEnabled"],
            "additionalProperties": false
        },
        "PremiumSubscription": {
            "type": "object",
            "properties": {
                "subscriptionType": {
                    "type": "string",
                    "const": "premium"
                },
                "startDate": {},
                "endDate": {
                    "anyOf": [
                        {},
                        {
                            "type": "null"
                        }
                    ]
                },
                "maxDevices": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                },
                "hdStreaming": {
                    "type": "boolean"
                }
            },
            "required": ["subscriptionType", "startDate", "endDate", "maxDevices", "hdStreaming"],
            "additionalProperties": false
        },
        "EnterpriseSubscription": {
            "type": "object",
            "properties": {
                "subscriptionType": {
                    "type": "string",
                    "const": "enterprise"
                },
                "startDate": {},
                "endDate": {
                    "anyOf": [
                        {},
                        {
                            "type": "null"
                        }
                    ]
                },
                "companyName": {
                    "type": "string"
                },
                "userLimit": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                },
                "supportPriority": {
                    "$ref": "#/definitions/SupportPriority"
                }
            },
            "required": [
                "subscriptionType",
                "startDate",
                "endDate",
                "companyName",
                "userLimit",
                "supportPriority"
            ],
            "additionalProperties": false
        },
        "SupportPriority": {
            "type": "string",
            "enum": ["standard", "priority", "dedicated"]
        }
    }
}
